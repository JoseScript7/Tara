# ──────────────────────────────────────────────
# Tara — Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# AWS Region
AWS_REGION=ap-south-1

# Bedrock Model Configuration
# VERIFY these against your Bedrock console
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Sarvam AI
# VERIFY against current Sarvam docs
SARVAM_API_KEY=
SARVAM_API_ENDPOINT=

# Database
DATABASE_URL=
AURORA_ENDPOINT=
AURORA_SECRET_ARN=

# S3 Buckets
DECISION_LOGS_BUCKET=
ARTIFACTS_BUCKET=

# SQS Queue URLs
SQS_TRANSACTIONS_URL=
SQS_TELEMETRY_URL=
SQS_SIGNALS_URL=
SQS_AGENT_DECISIONS_URL=

# Core Mock
COREBANK_ENDPOINT=
COREBANK_CLIENT_CERT_ARN=
COREBANK_CA_CERT_ARN=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Langfuse (optional, for local dev)
LANGFUSE_PUBLIC_KEY=pk-lf-tara-demo
LANGFUSE_SECRET_KEY=sk-lf-tara-demo
LANGFUSE_HOST=http://localhost:3000

# Feature Flags
ENABLE_SARVAM=false
ENABLE_VOICE=false
ENABLE_VISION=false
MOCK_MODE=true
